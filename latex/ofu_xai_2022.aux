\newlabel{fig:appendix_pixelate}{{2}{14}{Classification accuracy under pixelation corruption across five severity levels. Results are shown for a homogeneous ResNet ensemble, the heterogeneous mixed-model ensemble, and the strongest single backbones (ResNet-50 and ViT-B/16). All evaluations are conducted on the synthetic corruption benchmark}{figure.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Per-class accuracy (\%) on the phone-captured out-of-distribution dataset. Columns compare the heterogeneous ensemble with its constituent backbones (DenseNet-121, EfficientNet-B0, ResNet-34, and ViT-B/16). The overall row reports aggregate accuracy across classes.}}{15}{table.5}\protected@file@percent }
\newlabel{tab:hetero_phone}{{5}{15}{Per-class accuracy (\%) on the phone-captured out-of-distribution dataset. Columns compare the heterogeneous ensemble with its constituent backbones (DenseNet-121, EfficientNet-B0, ResNet-34, and ViT-B/16). The overall row reports aggregate accuracy across classes}{table.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Test accuracy on the phone-captured dataset for uniform averaging (Simple Mean Ensemble), the strongest single backbone (ViT-B/16), and the Mixture-of-Experts (MoE) router. Percentage annotations indicate relative improvement over uniform averaging.}}{15}{figure.3}\protected@file@percent }
\newlabel{fig:moe_improve}{{3}{15}{Test accuracy on the phone-captured dataset for uniform averaging (Simple Mean Ensemble), the strongest single backbone (ViT-B/16), and the Mixture-of-Experts (MoE) router. Percentage annotations indicate relative improvement over uniform averaging}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Average routing weight assigned to each backbone by the mixture-of-experts router on the phone-captured dataset. Weights are averaged across all samples. The router assigns the majority of probability mass to the ViT-B/16 backbone.}}{16}{figure.4}\protected@file@percent }
\newlabel{fig:moe_weights}{{4}{16}{Average routing weight assigned to each backbone by the mixture-of-experts router on the phone-captured dataset. Weights are averaged across all samples. The router assigns the majority of probability mass to the ViT-B/16 backbone}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Breakdown of routing outcomes on the phone-captured dataset. Samples are categorized as: (i) router selects a correct expert (“Router Optimal”), (ii) router selects an incorrect expert although another expert predicts correctly (“Missed Oracle”), and (iii) all experts predict incorrectly (“All Experts Wrong”). Percentages indicate the proportion of total evaluation samples in each category.}}{16}{figure.5}\protected@file@percent }
\newlabel{fig:moe_missed}{{5}{16}{Breakdown of routing outcomes on the phone-captured dataset. Samples are categorized as: (i) router selects a correct expert (“Router Optimal”), (ii) router selects an incorrect expert although another expert predicts correctly (“Missed Oracle”), and (iii) all experts predict incorrectly (“All Experts Wrong”). Percentages indicate the proportion of total evaluation samples in each category}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Class-wise distribution of missed oracle cases on the phone-captured dataset. The bars indicate the number of samples per class where the router selects the ViT backbone despite another expert predicting correctly.}}{17}{figure.6}\protected@file@percent }
\newlabel{fig:vit_fails}{{6}{17}{Class-wise distribution of missed oracle cases on the phone-captured dataset. The bars indicate the number of samples per class where the router selects the ViT backbone despite another expert predicting correctly}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Analysis of ViT failure characteristics on the phone-captured dataset. The x-axis shows the relative increase in blur for failure cases compared to successful predictions, and the y-axis indicates the number of failures per class. Pie charts denote the alternative expert (DenseNet-121, EfficientNet-B0, or ResNet-34) that correctly predicts the label in these cases.}}{17}{figure.7}\protected@file@percent }
\newlabel{fig:vit_bubble}{{7}{17}{Analysis of ViT failure characteristics on the phone-captured dataset. The x-axis shows the relative increase in blur for failure cases compared to successful predictions, and the y-axis indicates the number of failures per class. Pie charts denote the alternative expert (DenseNet-121, EfficientNet-B0, or ResNet-34) that correctly predicts the label in these cases}{figure.7}{}}
